{
  "$comment": "Machine-readable definition of the media-shelf data files (kept in the data/ folder of the separate media-shelf-data repository, ADR-0008, ADR-0010). File names are relative to that data folder. Single source of truth for tools (validator, UI). Human-readable rules: docs/csv-schema.md. Changes require an ADR.",
  "version": "ADR-0013",
  "file_conventions": {
    "encoding": "utf-8",
    "bom": false,
    "delimiter": ",",
    "list_separator": "|",
    "line_terminator": "\n"
  },
  "core_columns": [
    {
      "name": "id",
      "type": "id",
      "required": true,
      "description": "<PREFIX>-<NNNN>, sequential per file, unique across files, never reused"
    },
    {
      "name": "original_title",
      "type": "text",
      "required": true,
      "description": "Title of the original release in its original language (romanized for non-Latin scripts)"
    },
    {
      "name": "edition_title",
      "type": "text",
      "required": true,
      "description": "Title as printed on the owned copy, standard capitalization"
    },
    {
      "name": "synopsis",
      "type": "text",
      "required": false,
      "description": "1-2 sentences in English, own words"
    },
    {
      "name": "genre",
      "type": "list",
      "required": false,
      "description": "English, lowercase, hyphenated, canonical",
      "style": "kebab",
      "synonyms": "genre_synonyms"
    },
    {
      "name": "creator",
      "type": "list",
      "required": false,
      "description": "Director / developer studio / author / showrunner"
    },
    {
      "name": "formats",
      "type": "list",
      "required": true,
      "values": "formats",
      "description": "Owned formats from the media type's vocabulary"
    },
    {
      "name": "release_date",
      "type": "date",
      "required": false,
      "description": "Original first release, YYYY-MM-DD or YYYY",
      "allow_year_only": true
    },
    {
      "name": "consumed",
      "type": "boolean",
      "required": true,
      "description": "true = watched/played/read"
    },
    {
      "name": "condition",
      "type": "integer",
      "required": false,
      "min": 1,
      "max": 5,
      "scale": "condition_scale",
      "description": "Physical wear; empty for digital-only items"
    },
    {
      "name": "missing_items",
      "type": "list",
      "required": false,
      "values": "missing_items",
      "description": "Missing pieces; empty = complete"
    },
    {
      "name": "rating",
      "type": "integer",
      "required": false,
      "min": 1,
      "max": 10,
      "description": "Personal rating; only when consumed"
    },
    {
      "name": "tags",
      "type": "list",
      "required": false,
      "description": "English, lowercase, hyphenated, canonical; never repeat a genre of the row",
      "style": "kebab",
      "synonyms": "tag_synonyms",
      "forbidden": "forbidden_tags"
    },
    {
      "name": "notes",
      "type": "text",
      "required": false,
      "description": "Free notes in English"
    },
    {
      "name": "reviewed",
      "type": "boolean",
      "required": true,
      "description": "true only when the owner confirmed the row"
    }
  ],
  "media_types": {
    "movie": {
      "label": "Movies",
      "file": "movies.csv",
      "id_prefix": "MOV",
      "formats": [
        "DVD",
        "Blu-ray",
        "4K UHD",
        "VHS",
        "Digital"
      ],
      "extra_columns": [
        {
          "name": "actors",
          "type": "list",
          "required": false,
          "description": "Main original cast in billing order, full names as credited; voice actors for animation and video games (original performances only, no dubbing)"
        }
      ]
    },
    "video_game": {
      "label": "Video games",
      "file": "video_games.csv",
      "id_prefix": "GAM",
      "formats": [
        "Physical",
        "Digital"
      ],
      "extra_columns": [
        {
          "name": "platform",
          "type": "list",
          "required": true,
          "values": "platforms",
          "description": "Platforms of the owned copies"
        },
        {
          "name": "actors",
          "type": "list",
          "required": false,
          "description": "Main original cast in billing order, full names as credited; voice actors for animation and video games (original performances only, no dubbing)"
        }
      ]
    },
    "book": {
      "label": "Books",
      "file": "books.csv",
      "id_prefix": "BOK",
      "formats": [
        "Paperback",
        "Hardcover",
        "eBook",
        "Audiobook"
      ],
      "extra_columns": [
        {
          "name": "isbn",
          "type": "isbn",
          "required": false,
          "description": "ISBN-10 or ISBN-13, digits only"
        },
        {
          "name": "publisher",
          "type": "text",
          "required": false
        },
        {
          "name": "pages",
          "type": "integer",
          "required": false,
          "min": 1
        }
      ]
    },
    "series": {
      "label": "Series",
      "file": "series.csv",
      "id_prefix": "SER",
      "formats": [
        "DVD",
        "Blu-ray",
        "4K UHD",
        "VHS",
        "Digital"
      ],
      "extra_columns": [
        {
          "name": "series_type",
          "type": "enum",
          "required": true,
          "values": "series_types"
        },
        {
          "name": "seasons",
          "type": "list",
          "required": false,
          "item_type": "integer",
          "min": 1,
          "description": "Owned season numbers; empty for miniseries"
        },
        {
          "name": "actors",
          "type": "list",
          "required": false,
          "description": "Main original cast in billing order, full names as credited; voice actors for animation and video games (original performances only, no dubbing)"
        }
      ]
    }
  },
  "vocabularies": {
    "digital_formats": [
      "Digital",
      "eBook",
      "Audiobook"
    ],
    "missing_items": {
      "box": [
        "movie",
        "series",
        "video_game"
      ],
      "manual": [
        "video_game"
      ],
      "cover_art": [
        "movie",
