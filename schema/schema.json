  "identifying_fields": [
    "original_title",
    "edition_title",
    "creator",
    "release_date",
    "formats"
  ],
  "review_queue": {
    "file": "review_queue.csv",
    "id_prefix": "REV",
    "columns": [
      {
        "name": "id",
        "type": "id",
        "required": true
      },
      {
        "name": "status",
        "type": "enum",
        "required": true,
        "values": "statuses"
      },
      {
        "name": "reason",
        "type": "enum",
        "required": true,
        "values": "reasons"
      },
      {
        "name": "media_type",
        "type": "enum",
        "required": false,
        "values": "media_types"
      },
      {
        "name": "description",
        "type": "text",
        "required": true
      },
      {
        "name": "question",
        "type": "text",
        "required": true
      },
      {
        "name": "candidates",
        "type": "list",
        "required": false
      },
      {
        "name": "photo",
        "type": "list",
        "required": false
      },
      {
        "name": "location",
        "type": "text",
        "required": false
      },
      {
        "name": "related_ids",
        "type": "list",
        "required": false,
        "references": "data_ids"
      },
      {
        "name": "created",
        "type": "date",
        "required": true
      },
      {
        "name": "resolved",
        "type": "date",
        "required": false
      },
      {
        "name": "resolution",
        "type": "text",
        "required": false
      },
      {
        "name": "notes",
        "type": "text",
        "required": false
      }
    ],
    "statuses": [
      "open",
      "resolved",
      "discarded"
    ],
    "reasons": {
      "unidentified": "Cannot tell what the item is.",
      "ambiguous": "Several candidates (e.g. original vs remake).",
      "box_set_contents": "The contents of a set are not visible.",
      "needs_check": "A row's data is inferred and must be confirmed on the physical item.",
      "schema_gap": "Does not fit the schema; needs an ADR.",
      "needs_photo": "Not visible enough; needs a new photo."
    }
  },
  "manifest": {
    "file": "shelf.json",
    "required": true,
    "fields": {
      "schema_version": {
        "type": "text",
        "required": true,
        "description": "Version of schema.json the data conforms to; must equal this file's version"
      }
    }
  }
}
